# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO - PELUQUERÍA POS
# ==============================================================================

# Entorno de ejecución: 'development' o 'production'
FLASK_ENV=development

# Modo Debug: 'True' para recarga automática y trazas, 'False' para producción
FLASK_DEBUG=True

# Puerto y Host del servidor
PORT=5000
HOST=127.0.0.1

# Clave secreta para sesiones y seguridad (cambiar en producción)
SECRET_KEY=cambiar-por-una-clave-secreta-segura-en-produccion

# Base de datos SQLite
DATABASE_PATH=peluqueria_pos.db

# Copias de seguridad automáticas
BACKUP_DIR=backups
MAX_BACKUPS=30
BACKUP_INTERVAL_HOURS=12
